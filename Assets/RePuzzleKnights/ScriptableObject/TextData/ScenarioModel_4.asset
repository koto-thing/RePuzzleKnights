      sentence: "\u300C\u3069\u3046\u3057\u3066\uFF01\uFF1F \u79C1\u305F\u3061\u306F\u3001\u4E16\u754C\u3092\u6551\u3063\u305F\u306F\u305A\u3067\u3057\u3087\u3046\uFF01\uFF1F
