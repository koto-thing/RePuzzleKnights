      name: 
      sentence: "\u5F7C\u5973\u306E\u201C\u6B8B\u5F71\u201D\u3060\u3051\u304C\u3001\u307E\u308B\u3067\u546A\u3044\u306E\u6838\u5FC3\u305D\u306E\u3082\u306E\u3067\u3042\u308B\u304B\u306E\u3088\u3046\u306B\u3001\u3053\u306E\u6DC0\u3093\u3060\u9B54\u529B\u306E\u4E2D\u5FC3\u306B\u3044\u305F\u3002\n\u3086\u3063\u304F\u308A\u3068\u9854\u3092\u4E0A\u3052\u305F\u5F7C\u5973\u306E\u77B3\u306B\u306F\u3001\u304B\u3064\u3066\u306E\u512A\u3057\u3055\u306F\u306A\u304F\u3001\u305F\u3060\u865A\u308D\u3067\u3001\u5E95\u306A\u3057\u306E\u95C7\u304C\u5E83\u304C\u3063\u3066\u3044\u308B\u3002"
