      sentence: "\u300C\u88CF\u5207\u308A\u8005\u3081\uFF01\u4EF2\u9593\u3092\u30A2\u30F3\u30C7\u30C3\u30C9\u306B\u3057\u3066\u5F04\u3093\u3067\u3044\u308B\u306E\u304B\uFF01\u300D"
