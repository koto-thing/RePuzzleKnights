  scenarioData:
    scenes:
    - id: 1
      name: 
      sentence: "\u9B54\u738B\u306E\u7389\u5EA7\u3092\u80CC\u306B\u3001\u79C1\u306F\u30C0\u30F3\u30B8\u30E7\u30F3\u3092\u9006\u8D70\u3057\u59CB\u3081\u305F\u3002\n\u4E00\u6B69\u8E0F\u307F\u51FA\u3059\u3054\u3068\u306B\u3001\u546A\u308F\u308C\u305F\u529B\u304C\u75BC\u304D\u3001\u79C1\u306E\u610F\u601D\u3068\u306F\u7121\u95A2\u4FC2\u306B\u300C\u6210\u308C\u306E\u679C\u3066\u300D\u3068\u5316\u3057\u305F\u4EF2\u9593\u305F\u3061\u306E\u201C\u6B8B\u5F71\u201D\u304C\u547C\u3073\u899A\u307E\u3055\u308C\u308B\u3002\n\u5F7C\u3089\u306F\u97F3\u3082\u306A\u304F\u79C1\u306E\u5F8C\u308D\u3092\u3064\u3044\u3066\u304F\u308B\u3002\u305D\u308C\u306F\u3001\u304B\u3064\u3066\u306E\u4FE1\u983C\u306B\u6E80\u3061\u305F\u884C\u8ECD\u3068\u306F\u4F3C\u3066\u3082\u4F3C\u3064\u304B\u306C\u3001\u9759\u304B\u3067\u51B7\u305F\u3044\u846C\u5217\u306E\u3088\u3046\u3060\u3063\u305F\u3002"
      image: 
    - id: 2
      name: ???
      sentence: "\u300C\u2026\u2026\u884C\u3053\u3046\u300D"
      image: 
    - id: 3
      name: 
      sentence: "\u8AB0\u306B\u8A00\u3046\u3067\u3082\u306A\u304F\u545F\u304D\u3001\u79C1\u306F\u5507\u3092\u565B\u3080\u3002\n\u3053\u306E\u529B\u3092\u4F7F\u3046\u3053\u3068\u3078\u306E\u7F6A\u60AA\u611F\u3068\u3001\u751F\u304D\u5EF6\u3073\u308B\u305F\u3081\u306E\u80CC\u5FB3\u611F\u306B\u3001\u5FC3\u304C\u8ECB\u307F\u3092\u4E0A\u3052\u308B\u3002\n\u305D\u308C\u3067\u3082\u3001\u9032\u307E\u306A\u304F\u3066\u306F\u306A\u3089\u306A\u3044\u3002"
      image: 
    - id: 4
      name: 
      sentence: "\u798D\u3005\u3057\u3044\u88C5\u98FE\u304C\u65BD\u3055\u308C\u305F\u9B54\u738B\u57CE\u306E\u56DE\u5ECA\u3092\u629C\u3051\u3001\u898B\u899A\u3048\u306E\u3042\u308B\u5CA9\u808C\u304C\u5265\u304D\u51FA\u3057\u306E\u901A\u8DEF\u3078\u51FA\u308B\u3002\n\u3053\u3053\u306F\u3001\u79C1\u305F\u3061\u8A0E\u4F10\u968A\u304C\u6700\u7D42\u6C7A\u6226\u306B\u5099\u3048\u3001\u62E0\u70B9\u3068\u3057\u3066\u3044\u305F\u524D\u54E8\u57FA\u5730\u3078\u3068\u7D9A\u304F\u9053\u3060\u3002\n\u9B54\u738B\u304C\u5012\u3055\u308C\u305F\u4ECA\u3001\u57FA\u5730\u306F\u795D\u52DD\u306E\u5BB4\u3067\u6CB8\u304D\u8FD4\u3063\u3066\u3044\u308B\u3060\u308D\u3046\u304B\u3002\u3044\u3084\u3001\u3042\u308B\u3044\u306F\u2026\u2026\u3002"
      image: 
    - id: 5
      name: 
      sentence: "\u3084\u304C\u3066\u8FBF\u308A\u7740\u3044\u305F\u524D\u54E8\u57FA\u5730\u306F\u3001\u79C1\u306E\u60AA\u3044\u4E88\u611F\u3092\u88CF\u5207\u308B\u3088\u3046\u306B\u3001\u9759\u307E\u308A\u8FD4\u3063\u3066\u3044\u305F\u3002\n\u52DD\u5229\u3092\u795D\u3046\u58F0\u306F\u306A\u304F\u3001\u4EBA\u306E\u6C17\u914D\u3082\u306A\u3044\u3002\n\u4E2D\u592E\u3067\u71FB\u3076\u308B\u711A\u304D\u706B\u306E\u71C3\u3048\u6BBB\u304C\u3001\u3064\u3044\u5148\u307B\u3069\u307E\u3067\u8AB0\u304B\u304C\u3053\u3053\u306B\u3044\u305F\u3053\u3068\u3092\u793A\u3057\u3066\u3044\u308B\u3060\u3051\u3060\u3063\u305F\u3002"
      image: 
    - id: 6
      name: 
      sentence: "\u738B\u8A0E\u4F10\u3068\u3044\u3046\u76EE\u7684\u3092\u679C\u305F\u3057\u305F\u672C\u968A\u306F\u3001\u3082\u3046\u3053\u3053\u3092\u5F15\u304D\u6255\u3063\u3066\u3057\u307E\u3063\u305F\u306E\u3060\u3002\n\u4E16\u754C\u304B\u3089\u3001\u79C1\u3060\u3051\u304C\u5207\u308A\u96E2\u3055\u308C\u3066\u3057\u307E\u3063\u305F\u304B\u306E\u3088\u3046\u306A\u3001\u6DF1\u3044\u5B64\u72EC\u304C\u80F8\u3092\u523A\u3059\u3002"
      image: 
    - id: 7
      name: 
      sentence: "\u57FA\u5730\u306E\u9685\u306B\u3001\u898B\u899A\u3048\u306E\u3042\u308B\u6728\u7BB1\u304C\u7F6E\u304B\u308C\u3066\u3044\u305F\u3002\u30AE\u30EB\u30D9\u30EB\u30C8\u3055\u3093\u304C\u3001\u3044\u3064\u3082\u611B\u7528\u306E\u5927\u5263\u3092\u624B\u5165\u308C\u3059\u308B\u305F\u3081\u306B\u8170\u639B\u3051\u3066\u3044\u305F\u5834\u6240\u3060\u3002\n\u5F7C\u306E\u96A3\u3067\u3001\u30D9\u30CD\u30C7\u30A3\u30AF\u30C8\u3055\u3093\u304C\u77E2\u7FBD\u6839\u3092\u6574\u3048\u3001\u30AB\u30C8\u30EC\u30A2\u3055\u3093\u304C\u50B7\u306B\u52B9\u304F\u85AC\u8349\u3092\u714E\u3058\u3066\u304F\u308C\u305F\u3002\n\u30A8\u30A4\u30DF\u30FC\u3055\u3093\u306F\u96E3\u3057\u3044\u9B54\u5C0E\u66F8\u3092\u8AAD\u307F\u89E3\u304D\u306A\u304C\u3089\u3001\u305D\u306E\u304A\u8336\u3092\u7F8E\u5473\u3057\u305D\u3046\u306B\u98F2\u3093\u3067\u3044\u305F\u3002"
      image: 
    - id: 8
      name: 
      sentence: "\u4F55\u6C17\u306A\u3044\u65E5\u5E38\u306E\u5149\u666F\u304C\u8133\u88CF\u3092\u3088\u304E\u308A\u3001\u6D99\u304C\u8FBC\u307F\u4E0A\u3052\u308B\u3002\n\u5F7C\u3089\u306E\u201C\u6B8B\u5F71\u201D\u3092\u4F7F\u5F79\u3057\u3066\u9032\u3080\u3053\u306E\u65C5\u306F\u3001\u5F7C\u3089\u306E\u601D\u3044\u51FA\u3092\u8E0F\u307F\u8E99\u308B\u884C\u70BA\u306B\u601D\u3048\u3066\u306A\u3089\u306A\u304B\u3063\u305F\u3002"
      image: 
    - id: 9
      name: 
      sentence: "\u305D\u306E\u6642\u3001\u3075\u3068\u6728\u7BB1\u306E\u6A2A\u306B\u8EE2\u304C\u308B\u4E00\u3064\u306E\u6728\u5263\u304C\u76EE\u306B\u5165\u3063\u305F\u3002\n\u30AE\u30EB\u30D9\u30EB\u30C8\u3055\u3093\u304C\u3001\u529B\u306E\u5165\u308A\u3059\u304E\u305F\u79C1\u306E\u5263\u306E\u7656\u3092\u76F4\u3059\u305F\u3081\u306B\u3001\u624B\u5408\u308F\u305B\u3067\u4F7F\u3063\u3066\u304F\u308C\u305F\u3082\u306E\u3060\u3002\n\u61D0\u304B\u3057\u3055\u306B\u99C6\u3089\u308C\u3001\u305D\u3063\u3068\u305D\u308C\u306B\u624B\u3092\u4F38\u3070\u3059\u3002"
      image: 
    - id: 10
      name: 
      sentence: "\u6307\u304C\u89E6\u308C\u305F\u3001\u77AC\u9593\u3002\n\u2015\u2015\u9583\u5149\u3068\u5171\u306B\u3001\u8A18\u61B6\u304C\u6D41\u308C\u8FBC\u3093\u3067\u304D\u305F\u3002"
      image: 
    - id: 11
      name: "\u30AE\u30EB\u30D9\u30EB\u30C8"
      sentence: "\u300C\u304A\u3044\u3001\u3082\u3063\u3068\u80A9\u306E\u529B\u3092\u629C\u3051\u3002\u305D\u3093\u306A\u3093\u3058\u3083\u3001\u9B54\u7269\u306B\u5F53\u305F\u308B\u524D\u306B\u3078\u3070\u3063\u3061\u307E\u3046\u305E\u300D"
      image: 
    - id: 12
      name: 
      sentence: "\u3076\u3063\u304D\u3089\u307C\u3046\u306B\u3001\u3051\u308C\u3069\u512A\u3057\u304F\u7B11\u3046\u30AE\u30EB\u30D9\u30EB\u30C8\u3055\u3093\u306E\u58F0\u3002\n\u6728\u5263\u304C\u6253\u3061\u5408\u3046\u4E7E\u3044\u305F\u97F3\u3002\u5915\u65E5\u306B\u7167\u3089\u3055\u308C\u305F\u5F7C\u306E\u6A2A\u9854\u2015\u2015\u3002"
      image: 
    - id: 13
      name: ???
      sentence: "\u300C\u3042\u3063\u2026\u2026\uFF01\u300D"
      image: 
    - id: 14
      name: 
      sentence: "\u5E7B\u5F71\u306F\u4E00\u77AC\u3067\u6D88\u3048\u305F\u304C\u3001\u78BA\u304B\u306A\u611F\u899A\u304C\u79C1\u306E\u4E2D\u306B\u6B8B\u3063\u3066\u3044\u305F\u3002\n\u30AE\u30EB\u30D9\u30EB\u30C8\u3055\u3093\u306E\u201C\u6B8B\u5F71\u201D\u304C\u3001\u5FAE\u304B\u306B\u5149\u3092\u5E2F\u3073\u3066\u63FA\u3089\u3081\u304F\u3002\u305D\u3057\u3066\u3001\u79C1\u306F\u7406\u89E3\u3059\u308B\u3002\n\u5F7C\u306E\u5263\u304C\u3001\u3069\u306E\u3088\u3046\u306B\u632F\u308B\u308F\u308C\u3001\u3069\u308C\u307B\u3069\u306E\u91CD\u3055\u3092\u6301\u3064\u306E\u304B\u3092\u3002"
      image: 
    - id: 15
      name: 
      sentence: "\u3053\u308C\u304C\u3001\u7269\u8A9E\u306E\u76EE\u7684\u3067\u793A\u3055\u308C\u305F\u300C\u8A18\u61B6\u306E\u6B20\u7247\uFF08\u30D1\u30BA\u30EB\uFF09\u300D\u3002"
      image: 
    - id: 16
      name: 
      sentence: "\u4EF2\u9593\u305F\u3061\u306E\u8A18\u61B6\u306B\u89E6\u308C\u308B\u3053\u3068\u3067\u3001\u79C1\u306F\u5F7C\u3089\u306E\u529B\u3092\u3088\u308A\u6DF1\u304F\u7406\u89E3\u3057\u3001\u3053\u306E\u546A\u308F\u308C\u305F\u529B\u3092\u5236\u5FA1\u3059\u308B\u8853\u3092\u5F97\u308B\u306E\u3060\u3002\n\u305D\u308C\u306F\u3001\u5F7C\u3089\u306E\u9B42\u306E\u6B20\u7247\u3092\u7E4B\u304E\u5408\u308F\u305B\u308B\u884C\u70BA\u306B\u4ED6\u306A\u3089\u306A\u3044\u3002"
      image: 
    - id: 17
      name: ???
      sentence: "\u300C\u30AE\u30EB\u30D9\u30EB\u30C8\u3055\u3093\u2026\u2026\u300D"
      image: 
    - id: 18
      name: 
      sentence: "\u7F6A\u60AA\u611F\u304C\u6D88\u3048\u305F\u308F\u3051\u3067\u306F\u306A\u3044\u3002\u3051\u308C\u3069\u3001\u4ECA\u306F\u5206\u304B\u308B\u3002\n\u5F7C\u3089\u306E\u8A18\u61B6\u3092\u96C6\u3081\u308B\u3053\u3068\u3053\u305D\u304C\u3001\u546A\u3044\u3092\u89E3\u304D\u3001\u5F7C\u3089\u306E\u9B42\u3092\u89E3\u653E\u3059\u308B\u552F\u4E00\u306E\u9053\u7B4B\u306A\u306E\u3060\u3068\u3002"
      image: 
    - id: 19
      name: 
      sentence: "\u79C1\u306F\u6728\u5263\u3092\u62FE\u3044\u4E0A\u3052\u3001\u4ECA\u306F\u4EA1\u304D\u9A0E\u58EB\u3078\u306E\u656C\u610F\u3092\u8FBC\u3081\u3066\u305D\u3063\u3068\u61D0\u306B\u3057\u307E\u3046\u3002\n\u305D\u3057\u3066\u3001\u9854\u3092\u4E0A\u3052\u305F\u3002\n\u76EE\u6307\u3059\u306F\u3001\u30C0\u30F3\u30B8\u30E7\u30F3\u306E\u3055\u3089\u306B\u4E0A\u5C64\u968E\u3002"
      image: 
    - id: 20
      name: 
      sentence: "\u5B64\u72EC\u306A\u5DE1\u793C\u306F\u3001\u307E\u3060\u59CB\u307E\u3063\u305F\u3070\u304B\u308A\u3060\u3002\n\u79C1\u306F\u9759\u304B\u306B\u4ED8\u304D\u5F93\u3046\u201C\u6B8B\u5F71\u201D\u305F\u3061\u3092\u7387\u3044\u3066\u3001\u524D\u54E8\u57FA\u5730\u3092\u5F8C\u306B\u3057\u3001\u6B21\u306E\u968E\u5C64\u3078\u3068\u7D9A\u304F\u77F3\u9020\u308A\u306E\u6249\u3078\u3068\u3001\u518D\u3073\u6B69\u307F\u3092\u9032\u3081\u308B\u306E\u3060\u3063\u305F\u3002"
