      name: 
      sentence: "\u305D\u306E\u6642\u3001\u79C1\u3092\u5E87\u3044\u7D9A\u3051\u3066\u304D\u305F\u4E09\u4EBA\u306E\u201C\u6B8B\u5F71\u201D\u304C\u3001\u304A\u307C\u308D\u3052\u306A\u5149\u3092\u653E\u3061\u59CB\u3081\u305F\u3002\n\u5F7C\u3089\u306F\u8A00\u8449\u3092\u767A\u3057\u306A\u3044\u3002\u3060\u304C\u3001\u305D\u306E\u610F\u5FD7\u306F\u75DB\u3044\u307B\u3069\u4F1D\u308F\u3063\u3066\u304F\u308B\u3002\n\u300C\u9078\u3079\u300D\u300C\u304A\u524D\u306E\u4FE1\u3058\u308B\u9053\u3092\u300D\u300C\u6211\u3005\u306F\u3001\u6700\u5F8C\u307E\u3067\u304A\u524D\u3092\u8B77\u308B\u300D"
