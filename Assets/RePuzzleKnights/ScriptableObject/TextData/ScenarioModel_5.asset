      name: 
      sentence: "\u79C1\u306F\u796D\u58C7\u306E\u4E2D\u592E\u306B\u7ACB\u3061\u3001\u5168\u3066\u306E\u201C\u6B8B\u5F71\u201D\u3092\u81EA\u3089\u306E\u5143\u306B\u547C\u3073\u623B\u3057\u305F\u3002\n\u56DB\u4EBA\u306E\u4EF2\u9593\u305F\u3061\u306E\u529B\u304C\u3001\u79C1\u306E\u5185\u306B\u6D41\u308C\u8FBC\u3093\u3067\u304F\u308B\u3002\n\u305D\u3057\u3066\u3001\u9B54\u738B\u5316\u304C\u59CB\u307E\u308A\u82E6\u60B6\u306E\u8868\u60C5\u3092\u6D6E\u304B\u3079\u308B\u30A8\u30A4\u30DF\u30FC\u3092\u3001\u79C1\u306F\u529B\u5F37\u304F\u62B1\u304D\u3057\u3081\u305F\u3002"
