      sentence: "\u79C1\u306F\u3001\u6C7A\u65AD\u3057\u305F\u3002\n\u79C1\u306F\u3001\u30A8\u30A4\u30DF\u30FC\u306E\u512A\u3057\u3055\u306B\u7518\u3048\u308B\u308F\u3051\u306B\u306F\u3044\u304B\u306A\u3044\u3002\u5F7C\u5973\u3092\u9B54\u738B\u306B\u306A\u3093\u3066\u3055\u305B\u306A\u3044\u3002\n\u3053\u306E\u624B\u3067\u3001\u5F7C\u5973\u3092\u300C\u6551\u3046\u300D\u306E\u3060\u3002"
