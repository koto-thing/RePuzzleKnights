      name: 
      sentence: "\u5F7C\u5973\u304C\u79C1\u3092\u653B\u6483\u3057\u3001\u796D\u58C7\u304B\u3089\u9060\u3056\u3051\u3088\u3046\u3068\u3057\u305F\u306E\u306F\u3001\u89AA\u53CB\u3067\u3042\u308B\u79C1\u306B\u300C\u89AA\u53CB\u6BBA\u3057\u300D\u3068\u3044\u3046\u7F6A\u3092\u80CC\u8CA0\u308F\u305B\u306A\u3044\u305F\u3081\u306E\u3001\u6700\u5F8C\u306E\u512A\u3057\u3055\u3067\u3042\u308A\u3001\u60B2\u75DB\u306A\u62B5\u6297\u3060\u3063\u305F\u3002"
